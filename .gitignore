build/
game_files
# analysis/ is per-worktree scratch, except the golden-frame hashes
# (golden.json); the reference frames in analysis/golden/frames/ are game
# output and stay local.
analysis/*
!analysis/golden/
analysis/golden/*
!analysis/golden/golden.json
# audio.json is thresholds; the reference WAVs in analysis/golden/audio/ are
# game output and stay local.
!analysis/golden/audio.json
analysis/golden/audio/
src/recomp/gen/
.venv-ghidra
build-*/
third_party
# blinx2 setup: the pinned venv, and the toolkit clone (it must not enter the
# -dirty hash of a packaged version).
.venv/
external/
# blinx2 package output: private bundles holding the game. Never commit them.
dist/
*.dmg
*.exe
*.pdb
*.nsi
*.tar
bench-logs/
scripts/bench.env
src/recomp/.gen-regenerating
# What gen/ was generated from (blinx2 package regenerates when it differs).
src/recomp/gen.key.json
.DS_Store
*.log
timeline/
__pycache__/
# Game data and game output, anywhere in the tree: never commit these.
*.xbe
*.iso
*.xiso
*.xpr
*.xwb
*.adx
*.sfd
*.ipk
*.wav
*.bmp
*.png
# The app icons: the game's title image (blinx2 package, build-pkg-*/icon/).
*.ico
*.icns
# README images (placeholders and screenshots), not game output
!docs/images/*.png
*.ppm
*.raw
*.sav
*.xsv
UDATA/
TDATA/
saves/
# Local Claude Code settings
.claude/settings.local.json
.ruff_cache/

# The pin mark blinx2.py writes in a CLI or toolkit clone (kept out of git).
.xbr-pin
