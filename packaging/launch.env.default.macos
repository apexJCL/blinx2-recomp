# Launcher defaults (macOS). Do not edit this file: a new app replaces it.
# Put your own KEY=value lines in
# ~/Library/Application Support/BLiNX2/config/launch.env; they win over these.
# Any RECOMP_* key from docs/env.md works there, e.g. RECOMP_PB_BACKEND=cpu.
RECOMP_PB_BACKEND=metal
# Controllers (through SDL). The game itself leaves host pads off on macOS so
# scripted and golden runs never see one; the app is for play.
RECOMP_HOST_PAD=1
# Game logs kept in logs/.
LOG_KEEP=10
